{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "playwright.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "types": ["electron-vite/node", "node"],
    "paths": {
      "@core/*": ["./src/core/*"]
    }
  }
}
